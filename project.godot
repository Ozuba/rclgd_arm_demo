; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="rclgd_arm_demo"
run/main_scene="res://Scenes/sim/SimEnv.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=120
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://icon.png"
config/icon="res://icon.png"

[autoload]

ROS="*uid://ogjufo6oe6h3"

[display]

window/size/mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/freecam_3D/plugin.cfg", "res://addons/rclgd/plugin.cfg")

[filesystem]

import/blender/enabled=false

[global_group]

Cones="Todos los miembros de este grupo son conos"

[physics]

3d/run_on_separate_thread=true
common/physics_ticks_per_second=200
